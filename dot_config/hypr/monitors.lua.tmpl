-- Monitors
{{- if eq .device "krabby" }}
hl.monitor({
    output = "HDMI-A-1",
    mode = "1920x1080@120",
    position = "0x0",
    scale = 1
})

hl.monitor({
    output = "DP-3",
    mode = "1920x1080@240",
    position = "1920x0",
    scale = 1
})

hl.monitor({
    output = "DP-2",
    mode = "1920x1080@100",
    position = "3840x0",
    scale = 1
})
{{ end -}}
{{- if eq .device "kabuki" }}
hl.monitor({
    output = "eDP-1",
    mode = "1920x1200@60",
    position = "0x1200",
    scale = 1
})

-- Fallback monitor rule
hl.monitor({
    output = "",
    mode = "1920x1080@60",
    position = "0x0",
    scale = 1
})
{{ end -}}
