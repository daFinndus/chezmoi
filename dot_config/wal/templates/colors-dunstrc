[global]
    monitor = 0
    follow = mouse
    width = 320
    origin = top-right
    offset = (20, 20)

    font = Minecraft 11
    line_height = 2

    padding = 10
    horizontal_padding = 12
    separator_height = 2

    frame_width = 2
    frame_color = "{color1}"
    corner_radius = 8

    background = "{background}"
    foreground = "{color1}"
    separator_color = frame
    transparency = 10

    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    stack_duplicates = true
    hide_duplicate_count = false
    show_age_threshold = 60

    sticky_history = yes
    history_length = 20

    browser = firefox
    always_run_script = true

[urgency_low]
    timeout = 3
    background = "{background}"
    foreground = "{color3}"
    frame_color = "{color3}"

[urgency_normal]
    timeout = 6
    background = "{background}"
    foreground = "{color6}"
    frame_color = "{color6}"

[urgency_critical]
    timeout = 0
    background = "{background}"
    foreground = "{color9}"
    frame_color = "{color9}"

[play_sound]
    summary = "*"
    script = $HOME/.config/dunst/audio.sh
