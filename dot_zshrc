export PATH=$PATH:/usr/local/texlive/2025/bin/x86_64-linux
export EDITOR=nvim

# Oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)

source $ZSH/oh-my-zsh.sh

# Plugins
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Aliases
alias ff="fzf --style full --bind 'focus:transform-header:file --brief {}'"
alias ls='eza $eza_params'
alias l='eza --git-ignore $eza_params'
alias ll='eza --all --header --long $eza_params'
alias llm='eza --all --header --long --sort=modified $eza_params'
alias la='eza -lbhHigUmuSa'
alias lx='eza -lbhHigUmuSa@'
alias lt='eza --tree $eza_params'
alias tree='eza --tree $eza_params'

alias metasploit='sudo $XDG_DATA_HOME/../bin/setup-metasploit.sh'

alias wallpaper='$XDG_DATA_HOME/../bin/set-wallpaper.sh'
alias theme-configurator='$XDG_DATA_HOME/../bin/theme-configurator.sh'

alias delamain='cd ~/Coding/delamain && uv run python main.py'
alias poke-calc='cd ~/Coding/poke-calc && uv run python main.py'

alias duplicati='$XDG_DATA_HOME/../bin/run-backups.sh'
alias pihole='$XDG_DATA_HOME/../bin/toggle-pihole.sh'

alias rmshit='python $XDG_DATA_HOME/../bin/rmshit.py'
alias reflector='sudo reflector --latest 5 --sort rate --save /etc/pacman.d/mirrorlist'

alias bash='kitty --config ~/.config/kitty/clean.conf bash & disown'

alias binds='bat -p ~/.config/hypr/binds.conf'

alias shfmt-alias='shfmt -i 2 -w -s'

alias suspend='sudo systemctl suspend'
alias shutdown='sudo shutdown now'
alias reboot='sudo reboot'

# This is for environment variables
[[ -f ~/.config/shell/environment.sh ]] && source ~/.config/shell/environment.sh

# This is for shortcuts
bindkey -N emacs

# This is so the color theme will automatically update on wallpaper change
(cat ~/.cache/wal/sequences &)

# This is for metasploit
export RUBYOPT="-W0"

# pnpm
export PNPM_HOME="/home/finn/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

. "$HOME/.local/share/../bin/env"
